{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "March 7th",
  "version": "0.2.0",
  "identifier": "com.szm.march7th",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "March 7th",
        "width": 240,
        "height": 260,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "focus": false,
        "visible": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "提醒设置",
        "url": "settings.html",
        "create": false,
        "visible": false,
        "focus": false,
        "focusable": true,
        "width": 460,
        "height": 620,
        "resizable": false,
        "dragDropEnabled": false
      },
      {
        "label": "reminder",
        "title": "待处理提醒",
        "url": "reminder.html",
        "create": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "width": 320,
        "height": 220,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
